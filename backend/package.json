{
  "name": "iip-backend",
  "version": "0.1.0",
  "description": "Internet Intelligence Platform — Express backend",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/workers/scan-worker.ts",
    "worker:dev": "tsx watch src/workers/scan-worker.ts",
    "db:dev": "tsx scripts/dev-postgres.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "arctic": "^3.7.0",
    "bullmq": "^5.58.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jose": "^6.1.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "playwright": "^1.62.1",
    "postgres": "^3.4.7",
    "rate-limiter-flexible": "^7.4.0",
    "resend": "^6.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/ioredis-mock": "^8.2.7",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^17.10.0-beta.17",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true
  }
}

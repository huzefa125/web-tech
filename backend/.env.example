# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

# ---- Datastores (match docker-compose.yml) ----
DATABASE_URL=postgres://iip:iip_dev_password@localhost:5432/iip
REDIS_URL=redis://localhost:6379

# ---- JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_min_32_chars_use_the_command_above_to_generate
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- Cookies ----
# Local dev runs over http, so Secure must be off. In production leave it unset
# (defaults to true) and set COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# ---- URLs ----
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---- OAuth (optional in dev; routes 501 until set) ----
# Google:  https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:8000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub:  https://github.com/settings/developers
#   Authorization callback URL: http://localhost:8000/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Email (optional in dev; emails log to console when unset) ----
RESEND_API_KEY=
EMAIL_FROM=Internet Intelligence <noreply@example.com>

# ---- Security policy ----
PASSWORD_MIN_LENGTH=12
HIBP_ENABLED=true
MAX_FAILED_LOGINS=10
LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true

# ---- Storage (captured HTML/CSS/JS + screenshots) ----
# 'local' writes under STORAGE_LOCAL_ROOT. 'r2' is not implemented yet and
# refuses to start — wire the driver before setting it.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage

# ---- Crawler (module 1) ----
CRAWLER_NAV_TIMEOUT_MS=30000
CRAWLER_ASSET_TIMEOUT_MS=10000
CRAWLER_MAX_ASSETS=50
CRAWLER_MAX_ASSET_BYTES=5000000
CRAWLER_VIEWPORT_WIDTH=1440
CRAWLER_VIEWPORT_HEIGHT=900

# ---- Queue ----
SCAN_QUEUE_CONCURRENCY=2
SCAN_JOB_ATTEMPTS=3

# ---- Quotas ----
FREE_SCANS_PER_DAY=5

# ---- Local dev without Docker (see backend/README.md) ----
# SCAN_QUEUE_DRIVER=inline
SCAN_QUEUE_DRIVER=redis
